{
  "version": "0.4.0",
  "created_at": "2026-09-27",
  "updated_at": "2026-10-13",
  "rules": {
    "project": {
      "repository_relation_mode": {
        "value": "same_repository",
        "options": [
          "independent_repositories",
          "same_repository"
        ],
        "labels": {
          "independent_repositories": "分别处理",
          "same_repository": "视为同一仓库"
        },
        "description": "当前项目的远程仓库协作策略",
        "set_at": "2026-09-27"
      },
      "large_file_size_limit": {
        "value": "1MB",
        "type": "file_size",
        "description": "单个暂存 blob 的大文件警告阈值",
        "set_at": "2026-09-27"
      }
    },
    "git-commit": {
      "empty_staging_mode": {
        "value": "stage_all",
        "options": [
          "prompt",
          "stage_all",
          "abort"
        ],
        "labels": {
          "prompt": "询问",
          "stage_all": "暂存全部",
          "abort": "终止"
        },
        "description": "暂存区为空时的行为",
        "set_at": "2026-09-27"
      },
      "commit_message_mode": {
        "value": "custom",
        "options": [
          "conventional_simple",
          "conventional_full",
          "custom"
        ],
        "labels": {
          "conventional_simple": "简单 Conventional",
          "conventional_full": "完整 Conventional",
          "custom": "自定义"
        },
        "description": "commit message 风格",
        "set_at": "2026-09-27"
      },
      "post_commit_push_mode": {
        "value": "prompt",
        "options": [
          "prompt",
          "always",
          "never"
        ],
        "labels": {
          "prompt": "询问",
          "always": "总是",
          "never": "从不"
        },
        "description": "independent_repositories 模式下 commit 成功后的 push 行为",
        "set_at": "2026-09-27"
      },
      "pre_check_mode": {
        "value": "disabled",
        "options": [
          "prompt",
          "disabled",
          "warn",
          "block"
        ],
        "labels": {
          "prompt": "每次询问",
          "disabled": "不检查",
          "warn": "检查仅警告",
          "block": "检查并阻止"
        },
        "description": "提交前的预检行为（大文件检测、敏感文件名检查、敏感信息扫描等）",
        "set_at": "2026-09-27"
      }
    },
    "git-release": {
      "prerelease_mode": {
        "value": "prompt",
        "options": [
          "prompt",
          "prerelease",
          "stable"
        ],
        "labels": {
          "prompt": "每次询问",
          "prerelease": "标记为预发布",
          "stable": "正式发布"
        },
        "description": "创建 GitHub Release 时的 prerelease 属性",
        "set_at": "2026-10-13"
      }
    },
    "git-extract": {
      "selection_mode": {
        "value": "unconfigured",
        "options": [
          "auto",
          "manual",
          "confirm"
        ],
        "labels": {
          "auto": "自动推断",
          "manual": "仅按参数",
          "confirm": "展示并确认"
        },
        "description": "路径选择模式（三类分类与 .gitignore 推断）",
        "set_at": "2026-10-13"
      },
      "new_files_mode": {
        "value": "prompt",
        "options": [
          "prompt",
          "all",
          "none"
        ],
        "labels": {
          "prompt": "每次询问",
          "all": "全添加",
          "none": "全不添加"
        },
        "description": "C 类非忽略新文件的处理策略",
        "set_at": "2026-10-13"
      },
      "extra_excludes": {
        "value": "",
        "description": "持久排除清单（逗号分隔 pathspec，运行时解析，任何模式均参与）",
        "set_at": "2026-10-13"
      }
    }
  }
}
